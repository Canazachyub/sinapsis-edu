<mxfile host="app.diagrams.net"><diagram name="1 Vista del alumno" id="1 Vista "><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="1 · Lo que vive el alumno: de la landing a su primer simulacro" style="text;whiteSpace=wrap;fontSize=24;fontColor=#10312D;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Blanco = pantalla · Verde = éxito · Ámbar = espera · Rojo = error · Rombo = decisión del sistema · Recuadros oscuros = qué protege la seguridad en ese paso" style="text;whiteSpace=wrap;fontSize=13;fontColor=#51625E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c3" value="1. LANDING&#xa;sinapsisedu.com&#xa;· Plataformas y precios&#xa;· &quot;Simulacro gratis&quot;" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="230" height="150" as="geometry"/></mxCell><mxCell id="c4" value="2. PLATAFORMA (ej. ENAM)&#xa;· Qué incluye · S/ 49 · 30 días&#xa;· [Comprar]" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="230" height="150" as="geometry"/></mxCell><mxCell id="c5" value="3. TUS DATOS&#xa;Nombre · correo · DNI · WhatsApp&#xa;☑ Acepto Términos y Privacidad&#xa;[Continuar al pago]" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="230" height="150" as="geometry"/></mxCell><mxCell id="c6" value="4. PAGO (ventana de la pasarela)&#xa;· Tarjeta  o  · Yape (código)&#xa;[Pagar S/ 49]" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="230" height="150" as="geometry"/></mxCell><mxCell id="c7" value="¿Resultado&#xa;del pago?" style="rhombus;whiteSpace=wrap;fillColor=#E3EEEC;strokeColor=#1F5B52;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="125" width="150" height="120" as="geometry"/></mxCell><mxCell id="c8" value="5a. ¡LISTO!&#xa;Acceso a ENAM hasta 10/12/2026&#xa;[Ir a mis simulacros]&#xa;+ correo con tu contraseña" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1310" y="90" width="250" height="125" as="geometry"/></mxCell><mxCell id="c9" value="5c. EN PROCESO&#xa;(PagoEfectivo / Yape lento)&#xa;&quot;Te avisamos por correo&quot;" style="rounded=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1310" y="230" width="250" height="110" as="geometry"/></mxCell><mxCell id="c10" value="5b. RECHAZADO&#xa;Motivo claro&#xa;[Reintentar] [Otro medio] [WhatsApp]" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1310" y="355" width="250" height="110" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="aprobado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#16A34A;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="pendiente" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#D97706;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="rechazado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="reintentar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;dashed=1;" edge="1" parent="1" source="c10" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1435" y="490"/><mxPoint x="945" y="490"/></Array></mxGeometry></mxCell><mxCell id="c19" value="aviso de la pasarela&#xa;→ se activa solo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#D97706;dashed=1;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="285"/><mxPoint x="1600" y="150"/></Array></mxGeometry></mxCell><mxCell id="c20" value="6. CORREO DE BIENVENIDA&#xa;Usuario + contraseña temporal&#xa;Vigencia · [Entrar]" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="230" height="150" as="geometry"/></mxCell><mxCell id="c21" value="7. LOGIN → PORTAL&#xa;Mis accesos · días restantes&#xa;[Rendir simulacro] [Banqueo]&#xa;[Renovar]" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="290" y="660" width="230" height="150" as="geometry"/></mxCell><mxCell id="c22" value="8. ENTRA A SIMULACROS&#xa;Se abre la app directo&#xa;(sin volver a escribir DNI)" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="560" y="660" width="230" height="150" as="geometry"/></mxCell><mxCell id="c23" value="9. SIMULACRO / BANQUEO&#xa;Solo los exámenes que compró&#xa;Marca de agua con su correo" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="830" y="660" width="230" height="150" as="geometry"/></mxCell><mxCell id="c24" value="10. AVISO DE VENCIMIENTO&#xa;Correo 3 días antes&#xa;y al vencer · [Renovar]" style="rounded=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1110" y="660" width="230" height="150" as="geometry"/></mxCell><mxCell id="c25" value="11. RENOVAR&#xa;Vuelve al paso 4 con datos&#xa;precargados; suma días" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1380" y="660" width="230" height="150" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#16A34A;exitX=1;exitY=0.3;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1660" y="128"/><mxPoint x="1660" y="625"/><mxPoint x="135" y="625"/></Array></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="PLAN B (se mantiene): pagar por voucher Yape / transferencia / Binance → el admin lo aprueba en el panel → mismo paso 5a (activarCompra)" style="rounded=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="560" y="860" width="500" height="70" as="geometry"/></mxCell><mxCell id="c33" value="si elige voucher" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#D97706;exitX=0;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="548" y="230"/><mxPoint x="548" y="895"/></Array></mxGeometry></mxCell><mxCell id="c34" value="🔒 Precio y monto fijados por el SERVIDOR (hoja Plataformas). El navegador no decide cuánto se cobra." style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="250" height="75" as="geometry"/></mxCell><mxCell id="c35" value="🔒 La compra queda PENDIENTE 30 min con un id único; luego expira." style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="520" width="250" height="75" as="geometry"/></mxCell><mxCell id="c36" value="🔒 La tarjeta nunca pasa por nuestro servidor: la pasarela nos da un token." style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="250" height="75" as="geometry"/></mxCell><mxCell id="c37" value="🔒 El servidor re-consulta el pago en la API de la pasarela y valida monto, moneda, estado, referencia y que el pago no se haya usado antes." style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="830" y="520" width="250" height="75" as="geometry"/></mxCell><mxCell id="c38" value="🔒 Activación idempotente (bloqueo) y alerta al admin si algo no cuadra." style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1110" y="520" width="300" height="75" as="geometry"/></mxCell><mxCell id="c39" value="🔒 Contraseña aleatoria, guardada solo como hash + sal." style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="250" height="65" as="geometry"/></mxCell><mxCell id="c40" value="🔒 Login con límite de intentos. 1 sesión activa por alumno." style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="960" width="250" height="65" as="geometry"/></mxCell><mxCell id="c41" value="🔒 Ticket firmado (HMAC) de 2 min y de un solo uso para pasar a simulacros." style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="560" y="960" width="250" height="65" as="geometry"/></mxCell><mxCell id="c42" value="🔒 Cada pedido valida sesión + acceso vigente a ESE examen. Sin clave en el navegador." style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="830" y="960" width="250" height="65" as="geometry"/></mxCell><mxCell id="c43" value="🔒 Al vencer, el servidor deja de entregar contenido aunque la app siga abierta." style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1110" y="960" width="300" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Secuencia del pago" id="2 Secuen"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="2 · Cómo se procesa un pago por dentro (Culqi; con Mercado Pago cambia solo el paso 6–9)" style="text;whiteSpace=wrap;fontSize=24;fontColor=#10312D;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1700" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Alumno&#xa;(navegador)" style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="70" width="180" height="56" as="geometry"/></mxCell><mxCell id="c3" value="" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;endArrow=none;dashed=1;strokeColor=#8A9A96;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="126" as="sourcePoint"/><mxPoint x="170" y="1250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="Web 1&#xa;sinapsisedu.com" style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="180" height="56" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;endArrow=none;dashed=1;strokeColor=#8A9A96;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="126" as="sourcePoint"/><mxPoint x="440" y="1250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="Pasarela&#xa;Culqi / Mercado Pago" style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="180" height="56" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;endArrow=none;dashed=1;strokeColor=#8A9A96;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="126" as="sourcePoint"/><mxPoint x="710" y="1250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="Backend 1&#xa;Apps Script SINAPSIS" style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="70" width="180" height="56" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;endArrow=none;dashed=1;strokeColor=#8A9A96;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="126" as="sourcePoint"/><mxPoint x="980" y="1250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="Google Sheets&#xa;Compras · Pagos · Accesos" style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="70" width="180" height="56" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;endArrow=none;dashed=1;strokeColor=#8A9A96;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="126" as="sourcePoint"/><mxPoint x="1250" y="1250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="Correo&#xa;Gmail del script" style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430" y="70" width="180" height="56" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;endArrow=none;dashed=1;strokeColor=#8A9A96;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="126" as="sourcePoint"/><mxPoint x="1520" y="1250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="1. Clic en Comprar ENAM + datos" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#1F5B52;fontColor=#1F5B52;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="170" as="sourcePoint"/><mxPoint x="440" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="2. iniciarCompra(slug, datos)" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#1F5B52;fontColor=#1F5B52;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="225" as="sourcePoint"/><mxPoint x="980" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="🔒 Lee precio de la hoja Plataformas · valida correo/DNI · límite de intentos" style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="994" y="240" width="300" height="44" as="geometry"/></mxCell><mxCell id="c17" value="3. Compra PENDIENTE {id_compra, monto 49.00 PEN, expira +30 min}" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#1F5B52;fontColor=#1F5B52;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="312" as="sourcePoint"/><mxPoint x="1250" y="312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="4. {id_compra, monto, llave PÚBLICA}" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#8A9A96;fontColor=#8A9A96;dashed=1;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="362" as="sourcePoint"/><mxPoint x="440" y="362" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="5. Abre checkout de la pasarela (monto fijo)" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#1F5B52;fontColor=#1F5B52;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="412" as="sourcePoint"/><mxPoint x="710" y="412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="6. Escribe tarjeta / aprueba Yape (fuera de nuestra web)" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#1F5B52;fontColor=#1F5B52;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="462" as="sourcePoint"/><mxPoint x="710" y="462" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="7. token del pago (tarjeta) u orden (Yape)" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#8A9A96;fontColor=#8A9A96;dashed=1;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="512" as="sourcePoint"/><mxPoint x="440" y="512" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="8. confirmarPago(id_compra, token)" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#1F5B52;fontColor=#1F5B52;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="562" as="sourcePoint"/><mxPoint x="980" y="562" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="🔒 Llave SECRETA solo en Script Properties · LockService" style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="994" y="577" width="300" height="40" as="geometry"/></mxCell><mxCell id="c24" value="9. Crear cargo: monto DE LA HOJA, referencia = id_compra" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#7C3AED;fontColor=#7C3AED;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="649" as="sourcePoint"/><mxPoint x="710" y="649" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="10. Respuesta: aprobado / rechazado + id_pago" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#8A9A96;fontColor=#8A9A96;dashed=1;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="699" as="sourcePoint"/><mxPoint x="980" y="699" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="🔒 VALIDA: estado aprobado · monto == 49.00 · PEN · referencia == id_compra · compra PENDIENTE no expirada · id_pago NUNCA usado antes" style="rounded=1;whiteSpace=wrap;fillColor=#7C3AED;fontColor=#FFFFFF;strokeColor=#7C3AED;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="994" y="739" width="420" height="62" as="geometry"/></mxCell><mxCell id="c27" value="11. activarCompra: Pagos(id_pago único) · Usuario · Acceso ENAM hasta 10/12 · Compra=APROBADA" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#1F5B52;fontColor=#1F5B52;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="829" as="sourcePoint"/><mxPoint x="1250" y="829" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="12. Correo de bienvenida (contraseña temporal + vigencia)" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#1F5B52;fontColor=#1F5B52;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="879" as="sourcePoint"/><mxPoint x="1520" y="879" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="13. {ok, acceso hasta 10/12, sesión}" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#8A9A96;fontColor=#8A9A96;dashed=1;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="929" as="sourcePoint"/><mxPoint x="440" y="929" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="14. Pantalla ¡Listo! → [Ir a mis simulacros]" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#8A9A96;fontColor=#8A9A96;dashed=1;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="979" as="sourcePoint"/><mxPoint x="170" y="979" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="— Camino asíncrono (Yape lento, PagoEfectivo, Mercado Pago) —" style="text;whiteSpace=wrap;fontSize=14;fontColor=#D97706;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="110" y="1039" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c32" value="A. Aviso (webhook) con id_pago" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#8A9A96;fontColor=#8A9A96;dashed=1;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="1079" as="sourcePoint"/><mxPoint x="980" y="1079" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="🔒 No se confía en el aviso: Apps Script no puede verificar su firma" style="rounded=1;whiteSpace=wrap;fillColor=#D97706;fontColor=#FFFFFF;strokeColor=#D97706;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="994" y="1094" width="330" height="40" as="geometry"/></mxCell><mxCell id="c34" value="B. GET pago por id_pago (re-consulta a la API)" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#7C3AED;fontColor=#7C3AED;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="1149" as="sourcePoint"/><mxPoint x="710" y="1149" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="C. Estado real del pago" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#8A9A96;fontColor=#8A9A96;dashed=1;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="1199" as="sourcePoint"/><mxPoint x="980" y="1199" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="D. Mismas validaciones y activarCompra (idempotente: si ya se activó por el paso 8, no hace nada)" style="text;whiteSpace=wrap;fontSize=12;fontColor=#10312D;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="1239" width="700" height="40" as="geometry"/></mxCell><mxCell id="c37" value="E. Reembolso / contracargo" style="endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;html=0;strokeColor=#DC2626;fontColor=#DC2626;labelBackgroundColor=none;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="1299" as="sourcePoint"/><mxPoint x="980" y="1299" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="F. Revoca el acceso, registra y avisa al admin" style="text;whiteSpace=wrap;fontSize=12;fontColor=#DC2626;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="1329" width="600" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Acceso y anti-pirateria" id="3 Acceso"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="3 · Una sola cuenta y contenido blindado (simulacros + banqueo)" style="text;whiteSpace=wrap;fontSize=24;fontColor=#10312D;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1700" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Portal (sinapsisedu.com)&#xa;Alumno con sesión&#xa;[Rendir simulacro ENAM]" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="230" height="110" as="geometry"/></mxCell><mxCell id="c3" value="Backend 1: emitirTicket&#xa;ticket = datos.firma HMAC-SHA256&#xa;{uid, examen, fin, exp 120 s, nonce}" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="270" height="110" as="geometry"/></mxCell><mxCell id="c4" value="Redirección a&#xa;app.sinapsisedu.com/#t=ticket&#xa;(fragmento: no viaja a servidores)" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="260" height="110" as="geometry"/></mxCell><mxCell id="c5" value="Backend 2: canjearTicket&#xa;✓ firma ✓ no vencido ✓ nonce sin usar&#xa;→ crea SU sesión · borra ticket de la URL" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="290" height="110" as="geometry"/></mxCell><mxCell id="c6" value="App de simulacros&#xa;solo muestra exámenes con&#xa;acceso vigente" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1350" y="90" width="260" height="110" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="✗ Ticket falso, vencido o reutilizado&#xa;→ &quot;Vuelve a entrar desde tu Portal&quot;" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="990" y="230" width="290" height="70" as="geometry"/></mxCell><mxCell id="c12" value="falla" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Cada pedido de preguntas a Backend 2 pasa por estos filtros:" style="text;whiteSpace=wrap;fontSize=16;fontColor=#10312D;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c14" value="Sesión válida&#xa;(token de servidor, 1 activa por alumno)" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="270" height="100" as="geometry"/></mxCell><mxCell id="c15" value="Acceso vigente&#xa;a ESE examen" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="340" y="380" width="270" height="100" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Límite de ritmo&#xa;≤ 60 preg/10 min · ≤ 400/día&#xa;lotes de 30" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="660" y="380" width="270" height="100" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Patrón anómalo?&#xa;(robot, varios dispositivos)&#xa;→ suspensión + alerta" style="rounded=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="980" y="380" width="270" height="100" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="Entrega preguntas&#xa;SIN clave ni justificación&#xa;+ marca de agua" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1300" y="380" width="270" height="100" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Cómo se revela la respuesta sin regalar el banco:" style="text;whiteSpace=wrap;fontSize=16;fontColor=#10312D;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c24" value="BANQUEO&#xa;Alumno elige opción → responder(id, opción)&#xa;→ el servidor devuelve correcta + justificación&#xa;de ESA pregunta y guarda su progreso" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="360" height="120" as="geometry"/></mxCell><mxCell id="c25" value="SIMULACRO&#xa;Preguntas sin clave → al Enviar, el servidor&#xa;califica, guarda la nota y recién entrega&#xa;la revisión de ESE intento" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="360" height="120" as="geometry"/></mxCell><mxCell id="c26" value="PANEL ADMIN&#xa;Ventas · accesos · dispositivos · alertas&#xa;(montos raros, scraping, cuentas compartidas)&#xa;Cerrar sesión remota / suspender" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10312D;strokeWidth=2;fontSize=12;arcSize=8;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="820" y="570" width="360" height="120" as="geometry"/></mxCell><mxCell id="c27" value="HOJAS Y LLAVES&#xa;Sheets privadas (no &quot;cualquiera con enlace&quot;)&#xa;Llaves y clave HMAC en Script Properties&#xa;Copia semanal automática" style="rounded=1;whiteSpace=wrap;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1220" y="570" width="390" height="120" as="geometry"/></mxCell><mxCell id="c28" value="Honestidad: nada en la web es 100 % inviolable (pueden fotografiar la pantalla). La meta es que copiar el banco completo sea lento, rastreable (marca de agua con su correo) y castigado (suspensión sin reembolso según Términos y Condiciones)." style="text;whiteSpace=wrap;fontSize=13;fontColor=#51625E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="1600" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>