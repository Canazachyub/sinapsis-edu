<mxfile host="app.diagrams.net"><diagram name="Flujo SINAPSIS" id="flujo"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="" style="rounded=0;fillColor=#F6F8F7;strokeColor=#E2E8E6;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="2680" height="170" as="geometry"/></mxCell><mxCell id="laneh0" value="ALUMNO" style="rounded=0;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="150" height="170" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8E6;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="2680" height="170" as="geometry"/></mxCell><mxCell id="laneh1" value="WEB 1 · sinapsisedu.com&#xa;(vende)" style="rounded=0;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="150" height="170" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=0;fillColor=#F6F8F7;strokeColor=#E2E8E6;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="2680" height="170" as="geometry"/></mxCell><mxCell id="laneh2" value="PASARELA&#xa;Mercado Pago / Culqi" style="rounded=0;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="150" height="170" as="geometry"/></mxCell><mxCell id="lane3" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8E6;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="2680" height="170" as="geometry"/></mxCell><mxCell id="laneh3" value="BACKEND 1 · Apps Script SINAPSIS&#xa;Usuarios · Compras · Accesos" style="rounded=0;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="150" height="170" as="geometry"/></mxCell><mxCell id="lane4" value="" style="rounded=0;fillColor=#F6F8F7;strokeColor=#E2E8E6;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="2680" height="170" as="geometry"/></mxCell><mxCell id="laneh4" value="WEB 2 · Simulacros&#xa;(simulaencib → app.sinapsisedu.com)" style="rounded=0;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="150" height="170" as="geometry"/></mxCell><mxCell id="lane5" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8E6;" vertex="1" parent="1"><mxGeometry x="20" y="970" width="2680" height="170" as="geometry"/></mxCell><mxCell id="laneh5" value="BACKEND 2 · Apps Script Simulacros&#xa;+ un Sheets por examen" style="rounded=0;fillColor=#10312D;fontColor=#FFFFFF;strokeColor=#10312D;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="970" width="150" height="170" as="geometry"/></mxCell><mxCell id="n11" value="1. Entra a sinapsisedu.com&#xa;(Facebook, WhatsApp, Google)" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="195" y="150.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n12" value="2. Elige plataforma&#xa;(ENAM · RM · SERUMS · EsSalud · ENCIB)&#xa;y llena datos de compra" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="195" y="320.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n13" value="3. registrarCompra → crea&#xa;Usuario + Compra PENDIENTE&#xa;(precio sale de la hoja)" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="660.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n14" value="4. crearPago → preferencia&#xa;(monto, referencia = id_compra)&#xa;FALTA" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="645" y="660.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n15" value="5. Paga con tarjeta / Yape&#xa;en la página de la pasarela&#xa;FALTA cuenta + llaves" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="645" y="490.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n16" value="6. Webhook + vuelta a /#/gracias&#xa;con payment_id&#xa;FALTA" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="490.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n17" value="Plan B: sube voucher Yape/transf.&#xa;→ admin aprueba en el panel&#xa;(hoy funciona, manual)" style="rounded=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="325.0" width="200" height="100" as="geometry"/></mxCell><mxCell id="n18" value="7. verificarPago: consulta la API,&#xa;monto = precio, estado aprobado&#xa;→ activarCompra  FALTA" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1095" y="660.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n19" value="8. Acceso ACTIVO: fecha_fin,&#xa;contraseña, correo al alumno&#xa;(aprobarPago ya lo hace)" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="660.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n20" value="9. Recibe correo con&#xa;credenciales y vigencia" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="150.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n21" value="10. Login → Portal: accesos,&#xa;días restantes y botón&#xa;“Entrar a simulacros ENAM”" style="rounded=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1545" y="320.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n22" value="11. emitirTokenSimulacros:&#xa;firma HMAC {correo, examen,&#xa;fecha_fin, exp 10 min}  FALTA" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1770" y="660.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n23" value="12. Abre la app de simulacros&#xa;con ?t=token (sin pedir DNI)&#xa;FALTA" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1770" y="830.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n24" value="13. validarToken: misma clave&#xa;secreta, revisa firma,&#xa;vencimiento y examen  FALTA" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1770" y="1000.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n25" value="14. Entrega preguntas SIN clave&#xa;(hoy envía la clave)" style="rounded=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1995" y="1000.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n26" value="15. Resuelve simulacro / banqueo&#xa;(selector de 5 exámenes: listo)" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1995" y="830.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n27" value="16. Califica en el servidor:&#xa;nota, por curso, historial&#xa;FALTA (hoy califica el navegador)" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2220" y="1000.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n28" value="17. Resultados + PDF +&#xa;“practicar cursos débiles”" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2445" y="830.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n29" value="18. Aviso de vencimiento&#xa;(3 días antes) → Renovar&#xa;→ vuelve al paso 4  FALTA" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2445" y="660.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#1F5B52;strokeWidth=2;fontSize=10;fontColor=#1F5B52;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="registrarCompra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#1F5B52;strokeWidth=2;fontSize=10;fontColor=#1F5B52;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="link de pago" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="payment_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n16" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="si paga por voucher" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#D97706;strokeWidth=2;fontSize=10;fontColor=#D97706;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=0;entryX=0.8;entryY=1;" edge="1" parent="1" source="n13" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="aprobado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#D97706;strokeWidth=2;fontSize=10;fontColor=#D97706;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.2;entryY=0;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="aprobado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="correo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#1F5B52;strokeWidth=2;fontSize=10;fontColor=#1F5B52;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#1F5B52;strokeWidth=2;fontSize=10;fontColor=#1F5B52;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n41" value="sesión" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n21" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="redirige con token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n44" value="válido" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#1F5B52;strokeWidth=2;fontSize=10;fontColor=#1F5B52;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#1F5B52;strokeWidth=2;fontSize=10;fontColor=#1F5B52;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n46" value="respuestas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n47" value="nota" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#1F5B52;strokeWidth=2;fontSize=10;fontColor=#1F5B52;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n48" value="vence pronto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;strokeColor=#DC2626;strokeWidth=2;fontSize=10;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="title" value="SINAPSIS EDU · Flujo integrado: venta → pago → acceso → simulacros" style="text;fontSize=22;fontStyle=1;fontColor=#10312D;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Hoy las dos webs NO están conectadas: los simulacros usan otra lista de acceso (hoja “confirmado” por DNI). El puente es el token firmado (pasos 11-13)." style="text;fontSize=13;fontColor=#51625E;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1700" height="30" as="geometry"/></mxCell><mxCell id="leg0" value="Ya existe y funciona" style="rounded=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1170" width="210" height="40" as="geometry"/></mxCell><mxCell id="leg1" value="Existe a medias / manual" style="rounded=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="1170" width="210" height="40" as="geometry"/></mxCell><mxCell id="leg2" value="Falta construir" style="rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1170" width="210" height="40" as="geometry"/></mxCell><mxCell id="falta" value="QUÉ FALTA (por prioridad)&#xa;1. Cuenta de pasarela (Mercado Pago o Culqi) y sus llaves guardadas en Script Properties.&#xa;2. Backend 1: crearPago, verificarPago y webhook idempotente (LockService); activarCompra compartida con aprobarPago.&#xa;3. Puente de acceso: emitirTokenSimulacros (Backend 1) + validarToken (Backend 2) con la MISMA clave HMAC; retirar la hoja “confirmado”.&#xa;4. Accesos por examen: comprar ENAM habilita solo ENAM (slug de plataforma = id de examen).&#xa;5. Seguridad de preguntas: simulacro sin clave, nota calculada en el servidor; banqueo devuelve la clave solo tras responder.&#xa;6. Una sesión activa por alumno y marca de agua con su correo.&#xa;7. Aviso de vencimiento + botón Renovar; correo de bienvenida con enlace directo a simulacros.&#xa;8. Dominio app.sinapsisedu.com para la web 2 (Cloudflare Pages o Netlify, gratis) y restringir los Sheets.&#xa;9. Legal: Libro de Reclamaciones, Términos y Privacidad (la pasarela los pide).&#xa;10. Unificar el WhatsApp (51984300510 vs 51974707622)." style="rounded=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="740" y="1170" width="1960" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>